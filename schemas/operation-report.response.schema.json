{
  "$defs": {
    "GroupBy": {
      "enum": [
        "name",
        "agent",
        "team"
      ],
      "title": "GroupBy",
      "type": "string"
    },
    "OperationRow": {
      "properties": {
        "calls": {
          "title": "Calls",
          "type": "integer"
        },
        "cost_usd": {
          "title": "Cost Usd",
          "type": "number"
        },
        "error_rate": {
          "title": "Error Rate",
          "type": "number"
        },
        "errors": {
          "title": "Errors",
          "type": "integer"
        },
        "input_tokens": {
          "title": "Input Tokens",
          "type": "integer"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "output_tokens": {
          "title": "Output Tokens",
          "type": "integer"
        },
        "p50_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P50 Ms"
        },
        "p95_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P95 Ms"
        },
        "p99_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P99 Ms"
        }
      },
      "required": [
        "key",
        "calls",
        "errors",
        "error_rate",
        "p50_ms",
        "p95_ms",
        "p99_ms",
        "input_tokens",
        "output_tokens",
        "cost_usd"
      ],
      "title": "OperationRow",
      "type": "object"
    },
    "SpanKind": {
      "enum": [
        "agent",
        "tool",
        "model",
        "memory",
        "workflow",
        "other"
      ],
      "title": "SpanKind",
      "type": "string"
    }
  },
  "$id": "https://github.com/kogunlowo123/agentops-slo-platform/schemas/operation-report.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "group_by": {
      "$ref": "#/$defs/GroupBy"
    },
    "kind": {
      "$ref": "#/$defs/SpanKind"
    },
    "latency_sample_limit": {
      "description": "Percentiles use at most this many most-recent successful calls",
      "title": "Latency Sample Limit",
      "type": "integer"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/OperationRow"
      },
      "title": "Rows",
      "type": "array"
    },
    "window_minutes": {
      "title": "Window Minutes",
      "type": "integer"
    }
  },
  "required": [
    "kind",
    "group_by",
    "window_minutes",
    "latency_sample_limit",
    "rows"
  ],
  "title": "OperationReport",
  "type": "object"
}
